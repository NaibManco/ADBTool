{
  "name": "android-dev-tool",
  "version": "0.3.5",
  "private": true,
  "description": "A local Android device debugging dashboard powered by ADB and scrcpy.",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 dist/main/main/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node_modules\\electron\\dist\\electron.exe .\"",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "node_modules\\electron\\dist\\electron.exe .",
    "package": "npm run build && electron-builder --win portable --x64",
    "test": "vitest run src",
    "test:watch": "vitest src"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@yume-chan/adb": "3.0.0-beta.2",
    "@yume-chan/adb-scrcpy": "3.0.0-beta.2",
    "@yume-chan/adb-server-node-tcp": "3.0.0-beta.2",
    "@yume-chan/scrcpy": "3.0.0-beta.2",
    "@yume-chan/scrcpy-decoder-webcodecs": "3.0.0-beta.2",
    "mp4-muxer": "5.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.local.androiddevtool",
    "productName": "Android Dev Tool",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/scrcpy",
        "to": "scrcpy",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/jadx",
        "to": "jadx",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Android-Dev-Tool-${version}-portable.${ext}"
    }
  }
}
